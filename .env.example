# bro env. copy to .env.local and fill in. .env.local is gitignored.
# every var below powers a REAL integration. leave one blank and that
# feature degrades to an honest "not configured" state (the app still
# runs), it never fakes success.

# ── MongoDB Atlas ── powers the real waitlist (write + count).
#   make a free cluster at https://www.mongodb.com/cloud/atlas , add a
#   db user, allow your IP, copy the connection string ("Connect" -> Drivers).
MONGODB_URI=
MONGODB_DB=bro

# ── Backboard ── powers "talk to bro" (real reply + persistent memory).
#   get a key at https://app.backboard.io (hackathon dashboard).
BACKBOARD_API_KEY=

# ── Solana ── the live mainnet pulse. the public RPC works with no key;
#   set this only if you have a faster/private RPC (Helius, QuickNode...).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── bro <-> jabby bridge (parallel work, /app) ── leave default locally.
# JABBY_URL=http://127.0.0.1:4632
# BRO_MODE=local
